{
  "name": "badfly-website",
  "version": "1.0.0",
  "private": true,
  "description": "BadFly — Custom apparel manufacturing for European brands.",
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-images.mjs",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "npx serve@latest out",
    "lint": "biome lint app components dictionaries lib scripts next.config.ts tailwind.config.ts postcss.config.mjs",
    "typecheck": "tsc --noEmit",
    "images:catalogue": "node scripts/extract-catalogue.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "images:placeholders": "node scripts/generate-placeholders.mjs",
    "images:check": "node scripts/check-images.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.23.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
